<mvc:View controllerName="hrrequest.hrm.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdcTable="sap.ui.mdc.table"
    xmlns="sap.m">
    <f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:actions>
                    <Button id="createRequestButton" text="Create New Request" type="Emphasized"
                        icon="sap-icon://add-document" visible="{listState>/canCreate}" press=".onCreateRequest"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" fitContainer="true" alignItems="Center" class="sapUiSmallMarginBottom">
                    <VBox class="sapUiTinyMarginEnd">
                        <Label text="Search Employee" />
                        <SearchField id="searchField" width="15rem" placeholder="Name or ID..." search=".onSearch"/>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd">
                        <Label text="Status" />
                        <ComboBox id="statusFilter" width="10rem" selectionChange=".onFilterChange">
                            <core:Item key="" text="All" />
                            <core:Item key="01" text="Draft" />
                            <core:Item key="02" text="Submitted" />
                            <core:Item key="03" text="Approved" />
                            <core:Item key="04" text="Rejected" />
                        </ComboBox>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd">
                        <Label text="Department" />
                        <ComboBox id="departmentFilter" width="18rem" placeholder="All departments"
                            selectionChange=".onFilterChange" change=".onFilterChange"
                            showSecondaryValues="true" items="{filters>/departments}">
                            <core:Item key="{filters>DepartmentID}" text="{filters>DepartmentID} - {filters>DepartmentName}" additionalText="{filters>DepartmentName}" />
                        </ComboBox>
                    </VBox>
                    <VBox class="sapUiTinyMarginEnd">
                        <Label text="Requested Role" />
                        <ComboBox id="roleFilter" width="16rem" placeholder="All roles"
                            selectionChange=".onFilterChange" change=".onFilterChange"
                            items="{filters>/roles}">
                            <core:Item key="{filters>RoleName}" text="{filters>RoleName}" additionalText="{filters>Description}" />
                        </ComboBox>
                    </VBox>
                    <Button text="Go" type="Emphasized" tooltip="Refresh request data"
                        press=".onGo" class="sapUiTinyMarginBegin sapUiSmallMarginTop"/>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <mdc:Table id="requestTable"
                header="{= 'Requests (' + ${listState>/count} + ')' }"
                headerVisible="true"
                delegate="{
                    name: 'hrrequest/hrm/delegate/RequestTableDelegate',
                    payload: { collectionName: 'Request' }
                }"
                p13nMode="Column,Sort"
                sortConditions='{"sorters":[{"name":"LastChangedAt","descending":true}]}'
                enableColumnResize="true"
                autoBindOnInit="true"
                showRowCount="false"
                rowPress=".onItemSelect"
                class="requestTable">
                <mdc:type>
                    <mdcTable:ResponsiveTableType growingMode="Scroll" showDetailsButton="true" />
                </mdc:type>
                <mdc:actions>
                    <Button text="Export" icon="sap-icon://excel-attachment" tooltip="Export requests to Excel" press=".onExportRequests"/>
                </mdc:actions>
                <mdc:columns>
                    <mdcTable:Column id="employeeColumn" dataProperty="TargetUser" header="Employee" width="13rem" importance="High">
                        <ObjectIdentifier title="{TargetUser}" text="{FirstName} {LastName}" titleActive="true" titlePress=".onItemSelect" />
                    </mdcTable:Column>
                    <mdcTable:Column id="requestColumn" dataProperty="ReqId" header="Request" width="9rem" importance="High">
                        <Text text="{ReqId}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="requestTypeColumn" dataProperty="ReqTypeText" header="Request Type" width="10rem" importance="High">
                        <Text text="{ReqTypeText}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="departmentColumn" dataProperty="Department" header="Department" width="10rem" importance="High">
                        <Text text="{Department}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="emailColumn" dataProperty="Email" header="Email" width="14rem" importance="Medium">
                        <Text text="{Email}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="createdAtColumn" dataProperty="CreatedAt" header="Created At" width="12rem" importance="Low">
                        <Text text="{ path: 'CreatedAt', formatter: 'hrrequest.hrm.model.formatter.formatDateTime' }" />
                    </mdcTable:Column>
                    <mdcTable:Column id="requestCreatorColumn" dataProperty="CreatedBy" header="Request Creator" width="11rem" importance="Low">
                        <Text text="{ parts: [{ path: 'RequestedBy' }, { path: 'CreatedBy' }], formatter: 'hrrequest.hrm.model.formatter.formatRequestCreator' }" />
                    </mdcTable:Column>
                    <mdcTable:Column id="lastChangedAtColumn" dataProperty="LastChangedAt" header="Last Changed At" width="12rem" importance="Low">
                        <Text text="{ path: 'LastChangedAt', formatter: 'hrrequest.hrm.model.formatter.formatDateTime' }" />
                    </mdcTable:Column>
                    <mdcTable:Column id="changedByColumn" dataProperty="LastChangedBy" header="Changed By" width="10rem" importance="Low">
                        <Text text="{LastChangedBy}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="approvedByColumn" dataProperty="ApprovedBy" header="Approved By" width="10rem" importance="Low">
                        <Text text="{ApprovedBy}" />
                    </mdcTable:Column>
                    <mdcTable:Column id="statusColumn" dataProperty="Status" header="Status" width="8rem" hAlign="End" importance="High">
                        <ObjectStatus text="{StatusText}" state="{= ${Status} === '01' ? 'Information' : (${Status} === '02' ? 'Warning' : (${Status} === '03' ? 'Success' : (${Status} === '04' ? 'Error' : 'None'))) }" />
                    </mdcTable:Column>
                </mdc:columns>
            </mdc:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
