<mvc:View controllerName="ziam.dashboard.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:mc="sap.suite.ui.microchart"
    xmlns="sap.m">
    <f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false" class="iamDashboard">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="IAM Operations Dashboard"/></f:heading>
                <f:expandedContent><Text text="Overview of users, requests and audit activity"/></f:expandedContent>
                <f:actions>
                    <Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh"/>
                    <Button text="Create Request" type="Emphasized" visible="{dashboard>/canCreate}" press=".onCreateRequest"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMarginBottom">
                    <ObjectStatus title="Last refresh" text="{dashboard>/lastRefresh}" state="Information" class="sapUiSmallMarginEnd"/>
                    <ObjectStatus title="Run by" text="{dashboard>/runBy}" class="sapUiSmallMarginEnd"/>
                    <ObjectStatus title="Data scope" text="All current records"/>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip text="{dashboard>/error}" type="Error" showIcon="true" visible="{= !!${dashboard>/error}}" class="sapUiSmallMarginBottom"/>
                <l:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginBottom">
                    <Panel headerText="Total Users" class="iamKpiCard"><content><ObjectNumber number="{dashboard>/kpi/totalUsers}" emphasized="true"/></content></Panel>
                    <Panel headerText="Active Users" class="iamKpiCard"><content><ObjectNumber number="{dashboard>/kpi/activeUsers}" state="Success"/></content></Panel>
                    <Panel headerText="Inactive / Locked" class="iamKpiCard"><content><ObjectNumber number="{dashboard>/kpi/inactiveUsers}" state="Error"/></content></Panel>
                    <Panel headerText="Pending Requests" class="iamKpiCard"><content><ObjectNumber number="{dashboard>/kpi/pendingRequests}" state="Warning"/></content></Panel>
                    <Panel headerText="Audit Events Today" class="iamKpiCard"><content><ObjectNumber number="{dashboard>/kpi/auditToday}" state="Information"/></content></Panel>
                </l:Grid>
                <l:Grid defaultSpan="XL4 L4 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginBottom">
                    <Panel headerText="Request status" class="iamDashboardPanel">
                        <content>
                            <VBox items="{dashboard>/requestStatus}">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Text text="{dashboard>label}" width="8rem"/>
                                    <ProgressIndicator percentValue="{dashboard>percent}" displayValue="{dashboard>count}" width="100%" state="{dashboard>state}"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>
                    <Panel headerText="Top audit actions" class="iamDashboardPanel">
                        <content>
                            <List items="{dashboard>/topActions}" showSeparators="Inner">
                                <StandardListItem title="{dashboard>label}" info="{dashboard>count}" infoState="Information"/>
                            </List>
                        </content>
                    </Panel>
                    <Panel headerText="Audit activity trend" class="iamDashboardPanel">
                        <content>
                            <mc:ColumnMicroChart width="100%" height="7rem" size="Responsive" showBottomLabels="true" allowColumnLabels="true" columns="{dashboard>/auditTrend}">
                                <mc:columns>
                                    <mc:ColumnMicroChartData value="{dashboard>count}" label="{dashboard>day}" color="{dashboard>color}"/>
                                </mc:columns>
                            </mc:ColumnMicroChart>
                            <Text text="Events in the last seven available days" class="sapUiTinyMarginTop"/>
                        </content>
                    </Panel>
                </l:Grid>
                <l:Grid defaultSpan="XL8 L8 M12 S12" hSpacing="1" vSpacing="1">
                    <Panel headerText="Requests requiring attention" class="iamDashboardPanel">
                        <layoutData><l:GridData span="XL8 L8 M12 S12"/></layoutData>
                        <content>
                            <Table items="{dashboard>/attentionRequests}" growing="true" growingThreshold="10" noDataText="No pending requests">
                                <columns>
                                    <Column><Text text="Request"/></Column>
                                    <Column><Text text="User"/></Column>
                                    <Column><Text text="Status"/></Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Last changed"/></Column>
                                </columns>
                                <items><ColumnListItem type="Navigation" press=".onRequestPress">
                                    <cells>
                                        <Link text="{dashboard>requestId}" press=".onRequestLinkPress"
                                            tooltip="Open request detail"/>
                                        <ObjectIdentifier title="{dashboard>targetUser}" text="{dashboard>fullName}"/>
                                        <ObjectStatus text="{dashboard>statusText}" state="{dashboard>state}"/>
                                        <Text text="{dashboard>changedAt}"/>
                                    </cells>
                                </ColumnListItem></items>
                            </Table>
                        </content>
                    </Panel>
                    <Panel headerText="Recent activity" class="iamDashboardPanel">
                        <layoutData><l:GridData span="XL4 L4 M12 S12"/></layoutData>
                        <content>
                            <List items="{dashboard>/recentActivity}" noDataText="No audit activity">
                                <StandardListItem title="{dashboard>actionLabel}" description="{dashboard>targetUser} · {dashboard>performedBy}" info="{dashboard>changedAt}"/>
                            </List>
                        </content>
                    </Panel>
                </l:Grid>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
